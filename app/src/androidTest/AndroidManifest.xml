<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:label="Launcher drag tests">
        <receiver android:name="app.still.launcher.BadgeTestReceiver" android:exported="true" />
        <activity android:name="app.still.launcher.BadgeTestActivity" android:label="Badge fixture" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name="app.still.launcher.DragTestWidgetProvider" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/drag_test_widget_info" />
        </receiver>
        <activity android:name="app.still.launcher.DragTestWidgetConfiguration" android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
    </application>
</manifest>
