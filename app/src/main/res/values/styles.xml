<resources>
    <style name="BaseTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#B6DAC7</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#102E2C</item>
        <item name="android:windowShowWallpaper">true</item>
    </style>
    <style name="AppTheme" parent="BaseTheme" />
    <!-- Only the home window reveals Android's wallpaper; keyboard setup keeps its solid theme. -->
    <style name="LauncherTheme" parent="AppTheme">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
</resources>
